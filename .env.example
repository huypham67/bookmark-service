APP_PORT=8080
SERVICE_NAME=bookmark-service
APP_HOST_NAME=/api/bookmark_service

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=bookmark_db
DB_SSLMODE=disable
DB_TIMEZONE=UTC

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=1

RATELIMIT_LIMIT=20
RATELIMIT_WINDOW=10s

# bookmark-service only VALIDATES tokens (relying party) — public key only.
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=user-service
JWT_AUDIENCE=bookmark-app
