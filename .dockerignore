# IDE & OS junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Git & CI (not needed inside the build)
.git
.gitignore
.github/

# Go build & test artifacts (regenerated inside the image)
bin/
bookmark-service
*.exe
*.test
*.out
*.tmp
*.log
vendor/
coverage/
coverage_report/
coverage.html
coverage.tmp

# Local env & secrets (keys are mounted at runtime, never baked in)
.env
.env.*
*.pem
keys/

# Docs & notes not needed in the builder
# NOTE: docs/ (generated swagger) IS required by main.go — do NOT ignore it
README.md
LICENSE
CLAUDE.md
